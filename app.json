{
  "expo": {
    "name": "Pixel Graphics",
    "slug": "pixel-graphics",
    "version": "1.0.0",
    "scheme": "pixel-graphics",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/nunito/Nunito_300Light.ttf",
            "node_modules/@expo-google-fonts/nunito/Nunito_400Regular.ttf",
            "node_modules/@expo-google-fonts/nunito/Nunito_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff",
        "permissions": [
          "READ_EXTERNAL_STORAGE",
          "WRITE_EXTERNAL_STORAGE"
        ]
      },
      "package": "com.mstof.myexpoapp"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#B3C0E6"

    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6c9614c3-ae84-4998-8f47-a6a4154f72b1"
      }
    },
    "build": {
      "preview": {
        "android": {
          "buildType": "apk"
        }
      }
    }
  }
}
